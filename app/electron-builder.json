{
  "$schema": "./node_modules/app-builder-lib/scheme.json",
  "appId": "hu.drmandoki.kezelesiterv",
  "directories": {
    "output": "release",
    "buildResources": "build-resources"
  },
  "files": ["dist-electron/**/*", "package.json", "!node_modules/**/*"],
  "asar": true,
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "executableName": "mandoki-dental"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "deleteAppDataOnUninstall": true,
    "artifactName": "Mandoki-Dental-Setup-${version}.${ext}"
  },
  "mac": {
    "target": [{ "target": "dmg", "arch": ["universal"] }],
    "identity": "-",
    "hardenedRuntime": false
  },
  "dmg": {
    "artifactName": "Mandoki-Dental-${version}-${arch}.${ext}"
  }
}

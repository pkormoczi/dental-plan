{
  "name": "mandoki-dental",
  "productName": "Mandoki Dental",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workflow": "node --test ../scripts/workflow/workflow.test.mjs",
    "docs-check": "node ../scripts/docs-check.mjs",
    "electron:build": "vite build --mode electron && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts",
    "electron:dev": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && concurrently -k -n vite,electron \"vite --mode electron --port 5173 --strictPort\" \"electron . --dev-server=http://localhost:5173/\"",
    "electron:start": "npm run electron:build && electron .",
    "test:electron": "npm run electron:package:dir && playwright test -c e2e",
    "electron:package": "npm run electron:build && electron-builder --publish never",
    "electron:package:dir": "npm run electron:build && electron-builder --publish never -c.win.target=dir -c.mac.target.target=dir -c.mac.target.arch=universal"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@react-pdf/renderer": "^4.5.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.7",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
